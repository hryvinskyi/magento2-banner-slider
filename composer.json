{
    "name": "hryvinskyi/magento2-banner-slider",
    "description": "Banner Slider core module: persistence, editors, storefront read services, responsive crops with WebP/AVIF variants, media uploads, video providers, cache refresh and media clean-up",
    "type": "magento2-module",
    "version": "2.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0",
        "hryvinskyi/image-binaries": "^1.0",
        "hryvinskyi/magento2-banner-slider-api": "^2.1",
        "magento/framework": "^103.0.7",
        "magento/module-cron": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-media-storage": "^100.4",
        "magento/module-store": "^101.1",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\BannerSlider\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hryvinskyi\\BannerSlider\\Test\\": "Test/"
        }
    },
    "archive": {
        "exclude": [
            "/Test"
        ]
    }
}
