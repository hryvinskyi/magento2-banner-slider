<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Purges cached pages of sliders and banners whose active window opened or closed since the last run -->
        <job name="hryvinskyi_banner_slider_refresh_scheduled_content"
             instance="Hryvinskyi\BannerSlider\Cron\RefreshScheduledContent" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <!-- Deletes media files nothing references; does nothing unless the orphan sweep is enabled in the config -->
        <job name="hryvinskyi_banner_slider_sweep_orphan_media"
             instance="Hryvinskyi\BannerSlider\Cron\SweepOrphanMedia" method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
    </group>
</config>
